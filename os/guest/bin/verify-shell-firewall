#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  printf 'Run this verifier with sudo so it can read the active ruleset.\n' >&2
  exit 77
fi

fail() {
  printf 'FAIL  %s\n' "$1" >&2
  exit 1
}

systemctl is-enabled --quiet shell-firewall.service || fail 'SHELL firewall is not enabled for startup.'
printf 'PASS  firewall enabled for startup\n'

systemctl is-active --quiet shell-firewall.service || fail 'SHELL firewall service is not active.'
printf 'PASS  firewall service active\n'

rules=$(nft list table inet shell_filter 2>/dev/null) || fail 'SHELL firewall table is not readable or installed.'
grep -q 'hook input.*policy drop' <<<"$rules" || fail 'Input policy is not drop.'
grep -q 'hook forward.*policy drop' <<<"$rules" || fail 'Forward policy is not drop.'
grep -q 'hook output.*policy accept' <<<"$rules" || fail 'Output policy is not accept.'
grep -q 'ct state established,related accept' <<<"$rules" || fail 'Established reply rule is missing.'
grep -q 'iifname "lo" accept' <<<"$rules" || fail 'Loopback rule is missing.'
printf 'PASS  active rule policies and recovery traffic verified\n'

getent ahosts archlinux.org >/dev/null 2>&1 || fail 'DNS resolution failed.'
printf 'PASS  DNS resolution works\n'

ping -c 1 -W 3 archlinux.org >/dev/null 2>&1 || fail 'Outbound network probe failed.'
printf 'PASS  outbound network works\n'

printf 'SHELL base firewall verification passed.\n'
