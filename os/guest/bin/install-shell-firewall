#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  printf 'Run this installer with sudo.\n' >&2
  exit 77
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source_root=$(cd -- "$script_dir/.." && pwd)
rules_source="$source_root/security/shell-base.nft"
unit_source="$source_root/systemd/shell-firewall.service"
rules_target='/etc/shell/security/shell-base.nft'
unit_target='/etc/systemd/system/shell-firewall.service'

for required in "$rules_source" "$unit_source"; do
  [[ -f "$required" ]] || { printf 'Required source file is missing: %s\n' "$required" >&2; exit 66; }
done
command -v nft >/dev/null 2>&1 || { printf 'nft is not installed.\n' >&2; exit 69; }
command -v systemctl >/dev/null 2>&1 || { printf 'systemctl is not installed.\n' >&2; exit 69; }

nft -c -f "$rules_source"
install -d -m 0755 /etc/shell/security
install -m 0644 "$rules_source" "$rules_target"
install -m 0644 "$unit_source" "$unit_target"
systemctl daemon-reload

if ! systemctl enable --now shell-firewall.service; then
  systemctl disable --now shell-firewall.service >/dev/null 2>&1 || true
  printf 'SHELL firewall activation failed and was disabled.\n' >&2
  exit 70
fi

systemctl is-active --quiet shell-firewall.service
nft list table inet shell_filter >/dev/null
printf 'SHELL base firewall is active.\n'
printf 'Recovery: sudo systemctl disable --now shell-firewall.service\n'
