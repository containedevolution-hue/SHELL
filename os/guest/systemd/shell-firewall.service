[Unit]
Description=SHELL base firewall
Documentation=https://github.com/containedevolution-hue/SHELL
Wants=network-pre.target
Before=network-pre.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/nft delete table inet shell_filter
ExecStart=/usr/bin/nft -f /etc/shell/security/shell-base.nft
ExecReload=/usr/bin/nft -f /etc/shell/security/shell-base.nft
ExecStop=-/usr/bin/nft delete table inet shell_filter
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
