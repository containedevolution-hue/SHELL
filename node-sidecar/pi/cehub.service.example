# Reference copy of the systemd unit setup.sh writes to
# /etc/systemd/system/cehub.service. The real unit is generated at install
# time so User= and WorkingDirectory= match the actual Pi user — do NOT
# install this file directly. This copy is here for review and version
# control.

[Unit]
Description=Tenari Command Center — Node sidecar (PouchDB + MCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PI_USER__
SupplementaryGroups=audio
WorkingDirectory=__SIDECAR_DIR__
ExecStart=/usr/bin/node index.js
Environment=LOCALHUB_HOST=0.0.0.0
Environment=NODE_ENV=production
EnvironmentFile=-/etc/cehub/audio.env
EnvironmentFile=-/etc/cehub/tunnel.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
