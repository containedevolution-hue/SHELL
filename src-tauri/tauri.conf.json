{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHELL",
  "version": "0.1.1",
  "identifier": "com.containedevolution.localhub",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-app-catalog.js",
    "beforeDevCommand": "node scripts/prepare-app-catalog.js",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SHELL",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "dedup",
        "title": "SHELL — Photo Duplicates",
        "url": "dedup.html",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "typing-trainer",
        "title": "SHELL — Typing Trainer",
        "url": "typing-trainer.html",
        "width": 1220,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "flow-hud",
        "title": "Flow",
        "url": "flow-hud.html",
        "width": 240,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.containedevolution.localhub", "localhub"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "category": "Utility",
    "shortDescription": "SHELL — a free, local-first operating environment",
    "longDescription": "SHELL provides a local-first desktop, core apps, files, browser capabilities, and optional integrations without requiring an account or Tenari.",
    "externalBin": ["binaries/node"],
    "resources": {
      "../node-sidecar/index.js": "node-sidecar/index.js",
      "../node-sidecar/package.json": "node-sidecar/package.json",
      "../node-sidecar/lib": "node-sidecar/lib",
      "../node-sidecar/mcp": "node-sidecar/mcp",
      "../node-sidecar/node_modules": "node-sidecar/node_modules",
      "../node-sidecar/catalog": "node-sidecar/catalog"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
