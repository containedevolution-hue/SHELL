{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenari Command Center",
  "version": "0.1.1",
  "identifier": "com.containedevolution.localhub",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tenari Command Center",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "dedup",
        "title": "Tenari — Photo Duplicates",
        "url": "dedup.html",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "typing-trainer",
        "title": "Tenari — Typing Trainer",
        "url": "typing-trainer.html",
        "width": 1220,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "flow-hud",
        "title": "Flow",
        "url": "flow-hud.html",
        "width": 240,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.containedevolution.localhub", "localhub"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "category": "Utility",
    "shortDescription": "Tenari Command Center — your machine's private layer",
    "longDescription": "Tenari Command Center runs Tenari on your own computer. It keeps your local-only Memory safe, gives your Companion the file and browser access you approve, and works when Tenari cannot be reached.",
    "externalBin": ["binaries/node"],
    "resources": {
      "../node-sidecar": "node-sidecar",
      "../../lib/flow-prompts.js": "lib/flow-prompts.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
