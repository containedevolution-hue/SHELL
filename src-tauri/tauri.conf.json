{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalHub",
  "version": "0.1.0",
  "identifier": "com.containedevolution.localhub",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Contained Evolution — LocalHub",
        "url": "https://app.containedevolution.com/localhub/",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "dedup",
        "title": "LocalHub — Photo Duplicates",
        "url": "dedup.html",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.containedevolution.localhub", "localhub"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "Utility",
    "shortDescription": "Contained Evolution local sync host",
    "longDescription": "LocalHub is the desktop host for Contained Evolution's Cyclone sync system. It runs a CouchDB-compatible engine on your LAN so your devices sync to your own machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
